APP_NAME=Text-to-SQL Clarification Engine
APP_VERSION=0.1.0
APP_ENVIRONMENT=development
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://app_user:dev_password_123@localhost:5432/text_to_sql

# LLM Provider Configuration (openrouter or gemini)
LLM_PROVIDER=openrouter

# OpenRouter Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.5-flash

# Gemini Configuration (Optional if using OpenRouter)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Retry and Timeout Configuration
LLM_MAX_RETRIES=3
LLM_INITIAL_RETRY_DELAY_SECONDS=1.0
LLM_TIMEOUT_SECONDS=30.0
